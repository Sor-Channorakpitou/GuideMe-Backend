# ─────────────────────────────────────────────
# GuideMe Backend — Environment Variables
# ─────────────────────────────────────────────
# Copy this to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Database — replace with your Neon connection string
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase?sslmode=require"

# JWT
JWT_SECRET="your-random-secret-at-least-32-chars"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
FACEBOOK_APP_ID="your-facebook-app-id"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
UPLOAD_DIR="./uploads"

# CORS — your frontend URL
CLIENT_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Resend (transactional email — https://resend.com)
# Falls back to console.log if RESEND_API_KEY is empty
RESEND_API_KEY="re_xxxxx"
CONTACT_EMAIL=""

# Bakong payment webhook — shared secret used to verify the HMAC-SHA256
# signature on incoming /api/bakong-webhook calls. Leave blank to have the
# webhook reject all requests (fail closed) until Bakong integration is real.
BAKONG_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# Redis (optional — caches sessions, AI rate-limit counters, TTS audio URLs)
# Format: redis://:password@host:6379  or  rediss://... for TLS
# Leave blank to skip Redis and use Prisma + local disk as fallback.
# ─────────────────────────────────────────────
REDIS_URL=""
# REDIS_DISABLED=true   # set to "true" to bypass Redis entirely (CI / unit tests)

# ─────────────────────────────────────────────
# S3 / Cloudflare R2 — Audio CDN
# Leave S3_BUCKET blank to store TTS audio on local disk (development only).
# For production, point at an R2 bucket or any S3-compatible storage.
# ─────────────────────────────────────────────
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Cloudflare R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Public CDN base URL (e.g. https://cdn.guideme.app). Falls back to S3/R2 URL.
CDN_BASE_URL=""

# AI Intelligence & DOM Walkthrough Engine
# Universal AI Gateway (OpenRouter / OpenAI-Compatible — Top Priority)
# Set OPENROUTER_API_KEY to route AI calls through OpenRouter.
OPENROUTER_API_KEY="sk-or-v1-xxxx"
OPENROUTER_MODEL="google/gemini-3.5-flash"
# Optional: a cheaper model for FREE-plan requests specifically. Left unset
# by default — FREE uses the same OPENROUTER_MODEL as PRO/Business until you
# explicitly opt into a cheaper model here, since Khmer (the primary
# audience) is a low-resource language where cheaper models tend to lose
# more accuracy than on English. Only set this after validating Khmer
# quality on the cheaper model yourself.
# OPENROUTER_MODEL_FREE="google/gemini-3.5-flash-lite"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_TIMEOUT_MS=12000

# Google Gemini (Alternative/Fallback)
GEMINI_API_KEY="AIzaSy-xxxx"
GEMINI_MODEL="gemini-3-flash-preview"
# AI_API_KEY=""
